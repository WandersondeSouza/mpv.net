#: C:\Users\Wanderson\OneDrive\Documentos\MeusProjetos\WandersondeSouza\mpv.net\src\MpvNet.Windows\Properties\Resources.Designer.cs:114
msgid "theme"
msgstr "theme"

#~ msgid ""
#~ "(experimental) Win32, using WGL for rendering and Direct3D 9Ex for "
#~ "presentation. Works on Nvidia and AMD. Newer Intel chips with the latest "
#~ "drivers may also work."
#~ msgstr ""
#~ "(실험적) Win32, 렌더링에는 WGL를 사용하고 프레젠테이션에는 Direct3D 9Ex를 "
#~ "사용합니다. Nvidia 및 AMD에서 작동합니다. 최신 드라이버가 포함된 최신 "
#~ "Intel 칩도 작동할 수 있습니다."

#~ msgid ""
#~ "<-1.0..1.0> Brightness boost. Adds a constant bias onto the source "
#~ "luminance signal. 0.0 = neutral, 1.0 = solid white, -1.0 = solid black. "
#~ "Defaults to 0.0."
#~ msgstr ""
#~ "<-1.0..1.0> 밝기 향상. 소스 휘도 신호에 일정한 바이어스를 추가합니다. 0.0 "
#~ "= 중립, 1.0 = 흰색, -1.0 = 검정색. 기본값은 0.0입니다."

#~ msgid ""
#~ "<-1.143..5.286> Color temperature shift. Relative to 6500 K, a value of "
#~ "0.0 gives you 6500 K (no change), a value of -1.0 gives you 3000 K, and a "
#~ "value of 1.0 gives you 10000 K. Defaults to 0.0."
#~ msgstr ""
#~ "<-1.143..5.286> 색온도 변화. 6500 K와 관련하여 0.0 값은 6500 K(no 변경)를 "
#~ "제공하고 -1.0 값은 3000 K를 제공하며 1.0 값은 10000 K를 제공합니다. 기본값"
#~ "은 0.0입니다."

#~ msgid ""
#~ "<0-100> Set the JPEG quality level. Higher means better quality. The "
#~ "default is 90."
#~ msgstr ""
#~ "<0-100> JPEG 품질 수준을 설정합니다. 높을수록 품질이 좋아집니다. default"
#~ "는 90입니다."

#~ msgid ""
#~ "<0-32> In multi-monitor configurations (i.e. a single desktop that spans "
#~ "across multiple displays), this option tells mpv which screen to display "
#~ "the video on."
#~ msgstr ""
#~ "<0-32> 다중 모니터 구성(예: 여러 디스플레이에 걸쳐 있는 단일 데스크톱)에"
#~ "서 이 옵션은 비디오를 표시할 화면을 mpv에 알려줍니다."

#~ msgid ""
#~ "<0-5> Set the filter applied prior to PNG compression. 0 is none, 1 is "
#~ "'sub', 2 is 'up', 3 is 'average', 4 is 'Paeth', and 5 is 'mixed'. This "
#~ "affects the level of compression that can be achieved. For most images, "
#~ "'mixed' achieves the best compression ratio, hence it is the default."
#~ msgstr ""
#~ "<0-5> PNG 압축 이전에 적용되는 필터를 설정합니다. 0는 none, 1는 '서브', 2"
#~ "는 '업', 3는 '평균', 4는 'Paeth', 5는 '혼합'입니다. 이는 달성할 수 있는 압"
#~ "축 수준에 영향을 미칩니다. 대부분의 이미지에서 '혼합'이 최고의 압축률을 달"
#~ "성하므로 default입니다."

#~ msgid ""
#~ "<0-9> Set the PNG compression level. Higher means better compression. "
#~ "This will affect the file size of the written screenshot file and the "
#~ "time it takes to write a screenshot. Too high compression might occupy "
#~ "enough CPU time to interrupt playback. The default is 7."
#~ msgstr ""
#~ "<0-9> PNG 압축 수준을 설정합니다. 높을수록 더 나은 압축을 의미합니다. 이"
#~ "는 작성된 스크린샷 파일의 파일 크기와 스크린샷을 작성하는 데 걸리는 시간"
#~ "에 영향을 미칩니다. 압축률이 너무 높으면 재생을 중단할 만큼 충분한 CPU 시"
#~ "간을 차지할 수 있습니다. default는 7입니다."

#~ msgid ""
#~ "<0..1024> Gamut mapping 3DLUT size. Setting a dimension to 0 picks the "
#~ "default value. Defaults to 256."
#~ msgstr ""
#~ "<0..1024> Gamut 매핑 3DLUT 크기. 치수를 0로 설정하면 default 값이 선택됩니"
#~ "다. 기본값은 256입니다."

#~ msgid ""
#~ "<0..1024> Gamut mapping 3DLUT size. Setting a dimension to 0 picks the "
#~ "default value. Defaults to 32."
#~ msgstr ""
#~ "<0..1024> Gamut 매핑 3DLUT 크기. 치수를 0로 설정하면 default 값이 선택됩니"
#~ "다. 기본값은 32입니다."

#~ msgid ""
#~ "<0..1024> Gamut mapping 3DLUT size. Setting a dimension to 0 picks the "
#~ "default value. Defaults to 48."
#~ msgstr ""
#~ "<0..1024> Gamut 매핑 3DLUT 크기. 치수를 0로 설정하면 default 값이 선택됩니"
#~ "다. 기본값은 48입니다."

#~ msgid ""
#~ "<0..16> The number of debanding steps to perform per sample. Each step "
#~ "reduces a bit more banding, but takes time to compute. Note that the "
#~ "strength of each step falls off very quickly, so high numbers (>4) are "
#~ "practically useless. Defaults to 1."
#~ msgstr ""
#~ "<0..16> 샘플당 수행할 밴드 제거 단계 수입니다. 각 단계에서 밴딩이 조금 더 "
#~ "줄어들지만 계산하는 데 시간이 걸립니다. 각 단계의 강도는 매우 빠르게 떨어"
#~ "지므로 높은 숫자(>4)는 사실상 쓸모가 없습니다. 기본값은 1입니다."

#~ msgid ""
#~ "<0..4096> Tone mapping LUT size. Setting 0 picks the default size. "
#~ "Defaults to 256."
#~ msgstr ""
#~ "<0..4096> 톤 매핑 LUT 크기. 0를 설정하면 default 크기가 선택됩니다. 기본값"
#~ "은 256입니다."

#~ msgid ""
#~ "<0.0..0.5> Configures the knee point minimum as a percentage of the PQ "
#~ "luminance range. Provides a hard limit on the knee point chosen by "
#~ "knee_adaptation. Defaults to 0.1."
#~ msgstr ""
#~ "<0.0..0.5> PQ 휘도 범위의 백분율로 최소 니 포인트를 구성합니다. "
#~ "Knee_adaptation에 의해 선택된 Knee 포인트에 하드 제한을 제공합니다. 기본값"
#~ "은 0.1입니다."

#~ msgid ""
#~ "<0.0..1.0> (Relative) chromaticity protection zone for perceptual "
#~ "mapping. Defaults to 0.30."
#~ msgstr ""
#~ "<0.0..1.0>(상대) 지각 매핑을 위한 색도 보호 영역입니다. 기본값은 0.30입니"
#~ "다."

#~ msgid ""
#~ "<0.0..1.0> Antiringing strength to use for all filters. A value of 0.0 "
#~ "disables antiringing, and a value of 1.0 enables full-strength "
#~ "antiringing. Defaults to 0.0."
#~ msgstr ""
#~ "<0.0..1.0> all 필터에 사용할 링 방지 강도입니다. 0.0 값은 안티링잉을 비활"
#~ "성화하고, 1.0 값은 최대 강도의 안티링잉을 활성화합니다. 기본값은 0.0입니"
#~ "다."

#~ msgid ""
#~ "<0.0..1.0> Default knee point to use in the absence of source scene "
#~ "average metadata. Normally, this is ignored in favor of picking the knee "
#~ "point as the (relative) source scene average brightness level. Defaults "
#~ "to 0.4."
#~ msgstr ""
#~ "<0.0..1.0> 소스 장면 평균 메타데이터가 없을 때 사용할 기본 니 포인트입니"
#~ "다. 일반적으로 이는 무릎 지점을 (상대) 소스 장면 평균 밝기 수준으로 선택하"
#~ "기 위해 무시됩니다. 기본값은 0.4입니다."

#~ msgid "<0.0..1.0> Desaturation strength for softclip. Defaults to 0.35."
#~ msgstr "<0.0..1.0> 소프트클립의 채도 감소 강도입니다. 기본값은 0.35입니다."

#~ msgid ""
#~ "<0.0..1.0> For legacy functions (mobius, gamma) which operate on linear "
#~ "light, this directly sets the corresponding knee point. Defaults to 0.3."
#~ msgstr ""
#~ "<0.0..1.0> linear 조명에서 작동하는 레거시 기능(mobius, gamma)의 경우 해"
#~ "당 니 포인트를 직접 설정합니다. 기본값은 0.3입니다."

#~ msgid ""
#~ "<0.0..1.0> For the reinhard function, this specifies the local contrast "
#~ "coefficient at the display peak. Essentially, a value of 0.5 implies that "
#~ "the reference white will be about half as bright as when clipping. "
#~ "Defaults to 0.5."
#~ msgstr ""
#~ "<0.0..1.0> reinhard 기능의 경우 디스플레이 피크의 로컬 대비 계수를 지정합"
#~ "니다. 기본적으로 0.5 값은 참조 흰색이 클리핑할 때보다 약 절반 정도 밝아진"
#~ "다는 것을 의미합니다. 기본값은 0.5입니다."

#~ msgid ""
#~ "<0.0..1.0> Knee point to use for soft-clipping methods (perceptual, "
#~ "softclip). Defaults to 0.70."
#~ msgstr ""
#~ "<0.0..1.0> 소프트 클리핑 방법(지각적, 소프트 클립)에 사용할 니 포인트입니"
#~ "다. 기본값은 0.70입니다."

#~ msgid ""
#~ "<0.0..1.0> Strength of the perceptual saturation mapping component. "
#~ "Defaults to 0.80."
#~ msgstr ""
#~ "<0.0..1.0> 지각 채도 매핑 구성 요소의 강도입니다. 기본값은 0.80입니다."

#~ msgid "<0.0..1.0> The center (bias) of the sigmoid curve. Defaults to 0.75."
#~ msgstr ""
#~ "<0.0..1.0> 시그모이드 곡선의 중심(바이어스)입니다. 기본값은 0.75입니다."

#~ msgid ""
#~ "<0.0..10.0> For linear methods (linear, linearlight), this controls the "
#~ "linear exposure/gain applied to the image. Defaults to 1.0."
#~ msgstr ""
#~ "<0.0..10.0> linear 방법(linear, 선형 조명)의 경우 이미지에 적용되는 "
#~ "linear 노출/게인을 제어합니다. 기본값은 1.0입니다."

#~ msgid ""
