#~ msgid ""
#~ "(experimental) Win32, using WGL for rendering and Direct3D 9Ex for "
#~ "presentation. Works on Nvidia and AMD. Newer Intel chips with the latest "
#~ "drivers may also work."
#~ msgstr ""
#~ "(experimental) Win32, usando WGL para renderizado y Direct3D 9Ex para "
#~ "presentación. Funciona en Nvidia y AMD. Los chips Intel más nuevos con "
#~ "los controladores más recientes también pueden funcionar."

#~ msgid ""
#~ "<-1.0..1.0> Brightness boost. Adds a constant bias onto the source "
#~ "luminance signal. 0.0 = neutral, 1.0 = solid white, -1.0 = solid black. "
#~ "Defaults to 0.0."
#~ msgstr ""
#~ "<-1.0..1.0> Aumento de brillo. Añade una polarización constante a la "
#~ "señal de luminancia de la fuente. 0.0 = neutro, 1.0 = blanco sólido, -1.0 "
#~ "= negro sólido. El valor predeterminado es 0.0."

#~ msgid ""
#~ "<-1.143..5.286> Color temperature shift. Relative to 6500 K, a value of "
#~ "0.0 gives you 6500 K (no change), a value of -1.0 gives you 3000 K, and a "
#~ "value of 1.0 gives you 10000 K. Defaults to 0.0."
#~ msgstr ""
#~ "<-1.143..5.286> Cambio de temperatura de color. En relación con 6500 K, "
#~ "un valor de 0.0 proporciona 6500 K (cambio de no), un valor de -1.0 "
#~ "proporciona 3000 K y un valor de 1.0 proporciona 10000 K. El valor "
#~ "predeterminado es 0.0."

#~ msgid ""
#~ "<0-100> Set the JPEG quality level. Higher means better quality. The "
#~ "default is 90."
#~ msgstr ""
#~ "<0-100> Establece el nivel de calidad JPEG. Más alto significa mejor "
#~ "calidad. El default es 90."

#~ msgid ""
#~ "<0-32> In multi-monitor configurations (i.e. a single desktop that spans "
#~ "across multiple displays), this option tells mpv which screen to display "
#~ "the video on."
#~ msgstr ""
#~ "<0-32> En configuraciones de múltiples monitores (es decir, un único "
#~ "escritorio que abarca varias pantallas), esta opción le indica a mpv en "
#~ "qué pantalla mostrar el video."

#~ msgid ""
#~ "<0-5> Set the filter applied prior to PNG compression. 0 is none, 1 is "
#~ "'sub', 2 is 'up', 3 is 'average', 4 is 'Paeth', and 5 is 'mixed'. This "
#~ "affects the level of compression that can be achieved. For most images, "
#~ "'mixed' achieves the best compression ratio, hence it is the default."
#~ msgstr ""
#~ "<0-5> Establece el filtro aplicado antes de la compresión PNG. 0 es none, "
#~ "1 es 'sub', 2 está 'arriba', 3 es 'promedio', 4 es 'Paeth' y 5 es "
#~ "'mixto'. Esto afecta el nivel de compresión que se puede lograr. Para la "
#~ "mayoría de las imágenes, 'mixto' logra la mejor relación de compresión, "
#~ "de ahí que sea el default."

#~ msgid ""
#~ "<0-9> Set the PNG compression level. Higher means better compression. "
#~ "This will affect the file size of the written screenshot file and the "
#~ "time it takes to write a screenshot. Too high compression might occupy "
#~ "enough CPU time to interrupt playback. The default is 7."
#~ msgstr ""
#~ "<0-9> Establece el nivel de compresión PNG. Más alto significa mejor "
#~ "compresión. Esto afectará el tamaño del archivo de captura de pantalla "
#~ "escrito y el tiempo que lleva escribir una captura de pantalla. Una "
#~ "compresión demasiado alta puede ocupar suficiente tiempo como para "
#~ "interrumpir la reproducción. El default es 7."

#~ msgid ""
#~ "<0..1024> Gamut mapping 3DLUT size. Setting a dimension to 0 picks the "
#~ "default value. Defaults to 256."
#~ msgstr ""
#~ "<0..1024> Mapeo de gama Tamaño 3DLUT. Al establecer una dimensión en 0 se "
#~ "selecciona el valor default. El valor predeterminado es 256."

#~ msgid ""
#~ "<0..1024> Gamut mapping 3DLUT size. Setting a dimension to 0 picks the "
#~ "default value. Defaults to 32."
#~ msgstr ""
#~ "<0..1024> Mapeo de gama Tamaño 3DLUT. Al establecer una dimensión en 0 se "
#~ "selecciona el valor default. El valor predeterminado es 32."

#~ msgid ""
#~ "<0..1024> Gamut mapping 3DLUT size. Setting a dimension to 0 picks the "
#~ "default value. Defaults to 48."
#~ msgstr ""
#~ "<0..1024> Mapeo de gama Tamaño 3DLUT. Al establecer una dimensión en 0 se "
#~ "selecciona el valor default. El valor predeterminado es 48."

#~ msgid ""
#~ "<0..16> The number of debanding steps to perform per sample. Each step "
#~ "reduces a bit more banding, but takes time to compute. Note that the "
#~ "strength of each step falls off very quickly, so high numbers (>4) are "
#~ "practically useless. Defaults to 1."
#~ msgstr ""
#~ "<0..16> El número de pasos de eliminación de bandas que se deben realizar "
#~ "por muestra. Cada paso reduce un poco más las bandas, pero lleva tiempo "
#~ "calcularlo. Tenga en cuenta que la fuerza de cada paso disminuye muy "
#~ "rápidamente, por lo que los números altos (>4) son prácticamente "
#~ "inútiles. El valor predeterminado es 1."

#~ msgid ""
#~ "<0..4096> Tone mapping LUT size. Setting 0 picks the default size. "
#~ "Defaults to 256."
#~ msgstr ""
#~ "<0..4096> Tamaño de LUT de mapeo de tonos. La configuración 0 elige el "
#~ "tamaño default. El valor predeterminado es 256."

#~ msgid ""
#~ "<0.0..0.5> Configures the knee point minimum as a percentage of the PQ "
#~ "luminance range. Provides a hard limit on the knee point chosen by "
#~ "knee_adaptation. Defaults to 0.1."
#~ msgstr ""
#~ "<0.0..0.5> Configura el punto de inflexión mínimo como porcentaje del "
#~ "rango de luminancia PQ. Proporciona un límite estricto en el punto de "
#~ "inflexión elegido por Knee_adaptation. El valor predeterminado es 0.1."

#~ msgid ""
#~ "<0.0..1.0> (Relative) chromaticity protection zone for perceptual "
#~ "mapping. Defaults to 0.30."
#~ msgstr ""
#~ "<0.0..1.0> Zona de protección de cromaticidad (relativa) para mapeo "
#~ "perceptivo. El valor predeterminado es 0.30."

#~ msgid ""
#~ "<0.0..1.0> Antiringing strength to use for all filters. A value of 0.0 "
#~ "disables antiringing, and a value of 1.0 enables full-strength "
#~ "antiringing. Defaults to 0.0."
#~ msgstr ""
#~ "<0.0..1.0> Fuerza antiringing para usar con filtros all. Un valor de 0.0 "
#~ "deshabilita el antiringing y un valor de 1.0 habilita el antiringing con "
#~ "toda su potencia. El valor predeterminado es 0.0."

#~ msgid ""
#~ "<0.0..1.0> Default knee point to use in the absence of source scene "
#~ "average metadata. Normally, this is ignored in favor of picking the knee "
#~ "point as the (relative) source scene average brightness level. Defaults "
#~ "to 0.4."
#~ msgstr ""
#~ "<0.0..1.0> Punto de inflexión predeterminado que se utilizará en ausencia "
#~ "de metadatos promedio de la escena de origen. Normalmente, esto se ignora "
#~ "y se elige el punto de inflexión como el nivel de brillo promedio "
#~ "(relativo) de la escena fuente. El valor predeterminado es 0.4."

#~ msgid "<0.0..1.0> Desaturation strength for softclip. Defaults to 0.35."
#~ msgstr ""
#~ "<0.0..1.0> Fuerza de desaturación para softclip. El valor predeterminado "
#~ "es 0.35."

#~ msgid ""
#~ "<0.0..1.0> For legacy functions (mobius, gamma) which operate on linear "
#~ "light, this directly sets the corresponding knee point. Defaults to 0.3."
#~ msgstr ""
#~ "<0.0..1.0> Para funciones heredadas (mobius, gamma) que funcionan con la "
#~ "luz linear, esto establece directamente el punto de inflexión "
#~ "correspondiente. El valor predeterminado es 0.3."

#~ msgid ""
#~ "<0.0..1.0> For the reinhard function, this specifies the local contrast "
#~ "coefficient at the display peak. Essentially, a value of 0.5 implies that "
#~ "the reference white will be about half as bright as when clipping. "
#~ "Defaults to 0.5."
#~ msgstr ""
#~ "<0.0..1.0> Para la función reinhard, esto especifica el coeficiente de "
#~ "contraste local en el pico de visualización. Básicamente, un valor de 0.5 "
#~ "implica que el blanco de referencia será aproximadamente la mitad de "
#~ "brillante que cuando se recorta. El valor predeterminado es 0.5."

#~ msgid ""
#~ "<0.0..1.0> Knee point to use for soft-clipping methods (perceptual, "
#~ "softclip). Defaults to 0.70."
#~ msgstr ""
#~ "<0.0..1.0> Punto de inflexión para usar en métodos de recorte suave "
#~ "(perceptivo, clip suave). El valor predeterminado es 0.70."

#~ msgid ""
#~ "<0.0..1.0> Strength of the perceptual saturation mapping component. "
#~ "Defaults to 0.80."
#~ msgstr ""
#~ "<0.0..1.0> Fuerza del componente de mapeo de saturación perceptual. El "
#~ "valor predeterminado es 0.80."

#~ msgid "<0.0..1.0> The center (bias) of the sigmoid curve. Defaults to 0.75."
#~ msgstr ""
#~ "<0.0..1.0> El centro (sesgo) de la curva sigmoidea. El valor "
#~ "predeterminado es 0.75."

#~ msgid ""
#~ "<0.0..10.0> For linear methods (linear, linearlight), this controls the "
#~ "linear exposure/gain applied to the image. Defaults to 1.0."
#~ msgstr ""
#~ "<0.0..10.0> Para los métodos linear (linear, luz lineal), esto controla "
#~ "la exposición/ganancia linear aplicada a la imagen. El valor "
#~ "predeterminado es 1.0."

#~ msgid ""
#~ "<0.0..10.0> I vs C curve gamma to use for colorimetric clipping "
#~ "(relative, absolute and darken). Defaults to 1.80."
#~ msgstr ""
#~ "<0.0..10.0> Curva I vs C gamma para usar en recorte colorimétrico "
#~ "(relativo, absoluto y oscurecido). El valor predeterminado es 1.80."

#~ msgid "<0.0..100.0> Black cutoff strength."
#~ msgstr "<0.0..100.0> Fuerza de corte de negro."

#~ msgid ""
#~ "<0.0..100.0> Contrast gain. Multiplies the source luminance signal by a "
#~ "constant factor. 1.0 = neutral, 0.0 = solid black. Defaults to 1.0."
#~ msgstr ""
#~ "<0.0..100.0> Ganancia de contraste. Multiplica la señal de luminancia de "
#~ "la fuente por un factor constante. 1.0 = neutro, 0.0 = negro sólido. El "
#~ "valor predeterminado es 1.0."

#~ msgid ""
#~ "<0.0..100.0> Gamma lift. Subjectively brightnes or darkens the scene "
#~ "while preserving overall contrast. 1.0 = neutral, 0.0 = solid black. "
#~ "Defaults to 1.0."
#~ msgstr ""
#~ "<0.0..100.0> Elevación gamma. Aclara u oscurece subjetivamente la escena "
#~ "preservando el contraste general. 1.0 = neutro, 0.0 = negro sólido. El "
#~ "valor predeterminado es 1.0."

#~ msgid ""
#~ "<0.0..100.0> Saturation gain. Multiplies the source chromaticity signal "
#~ "by a constant factor. 1.0 = neutral, 0.0 = grayscale. Defaults to 1.0."
#~ msgstr ""
#~ "<0.0..100.0> Ganancia de saturación. Multiplica la señal de cromaticidad "
#~ "de origen por un factor constante. 1.0 = neutro, 0.0 = escala de grises. "
#~ "El valor predeterminado es 1.0."

#~ msgid ""
#~ "<0.0..100.0> Which percentile of the input image brightness histogram to "
#~ "consider as the true peak of the scene."
#~ msgstr ""
#~ "<0.0..100.0> Qué percentil del histograma de brillo de la imagen de "
#~ "entrada se debe considerar como el pico real de la escena."

#~ msgid ""
#~ "<0.0..1000.0> Add some extra noise to the image. This significantly helps "
#~ "cover up remaining quantization artifacts. Higher numbers add more noise. "
#~ "Defaults to 4.0, which is very mild."
#~ msgstr ""
#~ "<0.0..1000.0> Añade algo de ruido extra a la imagen. Esto ayuda "
#~ "significativamente a ocultar los artefactos de cuantificación restantes. "
#~ "Los números más altos añaden más ruido. El valor predeterminado es 4.0, "
#~ "que es muy leve."

#~ msgid "<0.0..1000.0> Smoothing coefficient for the detected values."
#~ msgstr "<0.0..1000.0> Coeficiente de suavizado para los valores detectados."

#~ msgid ""
#~ "<0.0..1000.0> The debanding filter's cut-off threshold. Higher numbers "
#~ "increase the debanding strength dramatically, but progressively diminish "
#~ "image details. Defaults to 3.0."
#~ msgstr ""
#~ "<0.0..1000.0> Umbral de corte del filtro de eliminación de bandas. Los "
#~ "números más altos aumentan drásticamente la fuerza de eliminación de "
#~ "bandas, pero disminuyen progresivamente los detalles de la imagen. El "
#~ "valor predeterminado es 3.0."

#~ msgid ""
#~ "<0.0..1000.0> The debanding filter's initial radius. The radius increases "
#~ "linearly for each iteration. A higher radius will find more gradients, "
#~ "but a lower radius will smooth more aggressively. Defaults to 16.0."
#~ msgstr ""
#~ "<0.0..1000.0> El radio inicial del filtro de eliminación de bandas. El "
#~ "radio aumenta linealmente para cada iteración. Un radio más alto "
#~ "encontrará más gradientes, pero un radio más bajo se suavizará de manera "
#~ "más agresiva. El valor predeterminado es 16.0."

#~ msgid ""
#~ "<0.5..1.0> Configures the knee point maximum as a percentage of the PQ "
#~ "luminance range. Provides a hard limit on the knee point chosen by "
#~ "knee_adaptation. Defaults to 0.8."
#~ msgstr ""
#~ "<0.5..1.0> Configura el punto de inflexión máximo como porcentaje del "
#~ "rango de luminancia PQ. Proporciona un límite estricto en el punto de "
#~ "inflexión elegido por Knee_adaptation. El valor predeterminado es 0.8."

#~ msgid ""
#~ "<0.5..2.0> Knee point offset (for bt2390 only). Note that a value of 0.5 "
#~ "is the spec-defined default behavior, which differs from the libplacebo "
#~ "default of 1.0."
#~ msgstr ""
#~ "<0.5..2.0> Desplazamiento del punto de rodilla (solo para bt2390). Tenga "
#~ "en cuenta que un valor de 0.5 es el comportamiento de default definido "
#~ "por especificación, que difiere del libplacebo default de 1.0."

#~ msgid ""
#~ "<1.0..20.0> The slope (steepness) of the sigmoid curve. Defaults to 6.5."
#~ msgstr ""
#~ "<1.0..20.0> La pendiente (inclinación) de la curva sigmoidea. El valor "
#~ "predeterminado es 6.5."

#~ msgid ""
#~ "<1.0..32.0> HDR contrast recovery lowpass kernel size. Increasing or "
#~ "decreasing this will affect the visual appearance substantially. Defaults "
#~ "to 3.5."
#~ msgstr ""
#~ "<1.0..32.0> HDR tamaño del kernel de paso bajo de recuperación de "
#~ "contraste. Aumentar o disminuir esto afectará sustancialmente la "
#~ "apariencia visual. El valor predeterminado es 3.5."

#~ msgid ""
#~ "<N|inf|force|no> Loops playback N times. A value of 1 plays it one time "
#~ "(default), 2 two times, etc. inf means forever. no is the same as 1 and "
#~ "disables looping. If several files are specified on command line, the "
#~ "entire playlist is looped. The force mode is like inf, but does not skip "
#~ "playlist entries which have been marked as failing. This means the player "
#~ "might waste CPU time trying to loop a file that doesn't exist. But it "
#~ "might be useful for playing webradios under very bad network conditions."
#~ msgstr ""
#~ "<N|inf|force|no> Reproducción en bucle N veces. Un valor de 1 se "
#~ "reproduce una vez (default), 2 dos veces, etc. inf significa para "
#~ "siempre. no es igual que 1 y desactiva el bucle. Si se especifican varios "
#~ "archivos en la línea de comando, se repite toda la lista de reproducción. "
#~ "El modo forzado es como inf, pero no omite las entradas de la lista de "
#~ "reproducción que se han marcado como fallidas. Esto significa que el "
#~ "reproductor podría perder tiempo intentando reproducir en bucle un "
#~ "archivo que no existe. Pero podría resultar útil para reproducir radios "
#~ "web en muy malas condiciones de red."

#~ msgid ""
#~ "<N|inf|no> Loop a single file N times. inf means forever, no means normal "
#~ "playback.\\n\\nThe difference to loop-playlist is that this doesn't loop "
#~ "the playlist, just the file itself. If the playlist contains only a "
#~ "single file, the difference between the two option is that this option "
#~ "performs a seek on loop, instead of reloading the file. loop is an alias "
#~ "for this option."
#~ msgstr ""
#~ "<N|inf|no> Repita un solo archivo N veces. inf significa para siempre, no "
#~ "significa reproducción normal.\\n\\nLa diferencia con loop-playlist es "
#~ "que esto no repite la lista de reproducción, solo el archivo en sí. Si la "
#~ "lista de reproducción contiene solo un archivo, la diferencia entre las "
#~ "dos opciones es que esta opción realiza una búsqueda en bucle, en lugar "
#~ "de recargar el archivo. loop es un alias para esta opción."

#~ msgid ""
#~ "<angle> Hue shift. Corresponds to a rotation of the UV subvector around "
#~ "the neutral axis. Specified in radians. Defaults to 0.0 (neutral)."
#~ msgstr ""
