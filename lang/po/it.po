msgstr "Specificare il carattere da utilizzare per i sottotitoli che non specificano un carattere particolare. L'impostazione predefinita è sans-serif."

#: C:\Users\Wanderson\OneDrive\Documentos\MeusProjetos\WandersondeSouza\mpv.net\src\MpvNet.Windows\Resources\editor_conf.txt:934
msgid "Specify the OSD font size. See sub-font-size for details. Default: 55"
msgstr "Specificare la dimensione del carattere OSD. Per i dettagli vedere la dimensione del carattere secondario. Predefinito: 55"

