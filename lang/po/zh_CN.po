#: C:\Users\Wanderson\OneDrive\Documentos\MeusProjetos\WandersondeSouza\mpv.net\src\MpvNet.Windows\Properties\Resources.Designer.cs:114
msgid "theme"
msgstr "主题"

#~ msgid ""
#~ "(experimental) Win32, using WGL for rendering and Direct3D 9Ex for "
#~ "presentation. Works on Nvidia and AMD. Newer Intel chips with the latest "
#~ "drivers may also work."
#~ msgstr ""
#~ "（实验）Win32，使用WGL进行渲染，使用Direct3D 9Ex进行演示。适用于 Nvidia "
#~ "和 AMD。具有最新驱动程序的较新 Intel 芯片也可能工作。"

#~ msgid ""
#~ "<-1.0..1.0> Brightness boost. Adds a constant bias onto the source "
#~ "luminance signal. 0.0 = neutral, 1.0 = solid white, -1.0 = solid black. "
#~ "Defaults to 0.0."
#~ msgstr ""
#~ "<-1.0..1.0> 亮度增强。在源亮度信号上添加恒定偏置。 0.0 = 中性色，1.0 = 纯"
#~ "白色，-1.0 = 纯黑色。默认为 0.0。"

#~ msgid ""
#~ "<-1.143..5.286> Color temperature shift. Relative to 6500 K, a value of "
#~ "0.0 gives you 6500 K (no change), a value of -1.0 gives you 3000 K, and a "
#~ "value of 1.0 gives you 10000 K. Defaults to 0.0."
#~ msgstr ""
#~ "<-1.143..5.286> 色温偏移。相对于 6500 K，0.0 的值给您 6500 K（no 更"
#~ "改），-1.0 的值给您 3000 K，1.0 的值给您 10000 K。默认为 0.0。"

#~ msgid ""
#~ "<0-100> Set the JPEG quality level. Higher means better quality. The "
#~ "default is 90."
#~ msgstr "<0-100> 设置 JPEG 质量级别。更高意味着更好的质量。 default 是 90。"

#~ msgid ""
#~ "<0-32> In multi-monitor configurations (i.e. a single desktop that spans "
#~ "across multiple displays), this option tells mpv which screen to display "
#~ "the video on."
#~ msgstr ""
#~ "<0-32> 在多显示器配置（即跨多个显示器的单个桌面）中，此选项告诉 mpv 在哪个"
#~ "屏幕上显示视频。"

#~ msgid ""
#~ "<0-5> Set the filter applied prior to PNG compression. 0 is none, 1 is "
#~ "'sub', 2 is 'up', 3 is 'average', 4 is 'Paeth', and 5 is 'mixed'. This "
#~ "affects the level of compression that can be achieved. For most images, "
#~ "'mixed' achieves the best compression ratio, hence it is the default."
#~ msgstr ""
#~ "<0-5> 设置 PNG 压缩之前应用的滤波器。 0 是 none，1 是“子”，2 是“上”，3 是"
#~ "“平均”，4 是“Paeth”，5 是“混合”。这会影响可以实现的压缩级别。对于大多数图"
#~ "像，“混合”可实现最佳压缩比，因此它是 default。"

#~ msgid ""
#~ "<0-9> Set the PNG compression level. Higher means better compression. "
#~ "This will affect the file size of the written screenshot file and the "
#~ "time it takes to write a screenshot. Too high compression might occupy "
#~ "enough CPU time to interrupt playback. The default is 7."
#~ msgstr ""
#~ "<0-9> 设置 PNG 压缩级别。越高意味着压缩效果越好。这会影响写入屏幕截图文件"
#~ "的文件大小以及写入屏幕截图所需的时间。太高的压缩可能会占用足够的 CPU 时间"
#~ "来中断播放。 default 是 7。"

#~ msgid ""
#~ "<0..1024> Gamut mapping 3DLUT size. Setting a dimension to 0 picks the "
#~ "default value. Defaults to 256."
#~ msgstr ""
#~ "<0..1024> 色域映射 3DLUT 大小。将尺寸设置为 0 会选取 default 值。默认为 "
#~ "256。"

#~ msgid ""
#~ "<0..1024> Gamut mapping 3DLUT size. Setting a dimension to 0 picks the "
#~ "default value. Defaults to 32."
#~ msgstr ""
#~ "<0..1024> 色域映射 3DLUT 大小。将尺寸设置为 0 会选取 default 值。默认为 "
#~ "32。"

#~ msgid ""
#~ "<0..1024> Gamut mapping 3DLUT size. Setting a dimension to 0 picks the "
#~ "default value. Defaults to 48."
#~ msgstr ""
#~ "<0..1024> 色域映射 3DLUT 大小。将尺寸设置为 0 会选取 default 值。默认为 "
#~ "48。"

#~ msgid ""
#~ "<0..16> The number of debanding steps to perform per sample. Each step "
#~ "reduces a bit more banding, but takes time to compute. Note that the "
#~ "strength of each step falls off very quickly, so high numbers (>4) are "
#~ "practically useless. Defaults to 1."
#~ msgstr ""
#~ "<0..16> 每个样本执行的去带步骤数。每一步都会减少更多的条带，但需要时间来计"
#~ "算。请注意，每个步骤的强度下降得非常快，因此高数字（> 4）实际上是无用的。"
#~ "默认为 1。"

#~ msgid ""
#~ "<0..4096> Tone mapping LUT size. Setting 0 picks the default size. "
#~ "Defaults to 256."
#~ msgstr "<0..4096> 色调映射 LUT 大小。设置 0 选择 default 尺寸。默认为 256。"

#~ msgid ""
#~ "<0.0..0.5> Configures the knee point minimum as a percentage of the PQ "
#~ "luminance range. Provides a hard limit on the knee point chosen by "
#~ "knee_adaptation. Defaults to 0.1."
#~ msgstr ""
#~ "<0.0..0.5> 将拐点最小值配置为 PQ 亮度范围的百分比。对knee_adaptation选择的"
#~ "拐点提供硬性限制。默认为 0.1。"

#~ msgid ""
#~ "<0.0..1.0> (Relative) chromaticity protection zone for perceptual "
#~ "mapping. Defaults to 0.30."
#~ msgstr "<0.0..1.0>（相对）色度保护区，用于感知映射。默认为 0.30。"

#~ msgid ""
#~ "<0.0..1.0> Antiringing strength to use for all filters. A value of 0.0 "
#~ "disables antiringing, and a value of 1.0 enables full-strength "
#~ "antiringing. Defaults to 0.0."
#~ msgstr ""
#~ "<0.0..1.0> 用于 all 滤波器的抗振铃强度。 0.0 为禁用抗振铃，1.0 为全强度抗"
#~ "振铃。默认为 0.0。"

#~ msgid ""
#~ "<0.0..1.0> Default knee point to use in the absence of source scene "
#~ "average metadata. Normally, this is ignored in favor of picking the knee "
#~ "point as the (relative) source scene average brightness level. Defaults "
#~ "to 0.4."
#~ msgstr ""
#~ "<0.0..1.0> 在没有源场景平均元数据的情况下使用的默认拐点。通常，这会被忽"
#~ "略，有利于选择拐点作为（相对）源场景平均亮度级别。默认为 0.4。"

#~ msgid "<0.0..1.0> Desaturation strength for softclip. Defaults to 0.35."
#~ msgstr "<0.0..1.0> 软夹去饱和强度。默认为 0.35。"

#~ msgid ""
#~ "<0.0..1.0> For legacy functions (mobius, gamma) which operate on linear "
#~ "light, this directly sets the corresponding knee point. Defaults to 0.3."
#~ msgstr ""
#~ "<0.0..1.0> 对于在 linear 灯上运行的旧功能（mobius、gamma），这直接设置相应"
#~ "的拐点。默认为 0.3。"

#~ msgid ""
#~ "<0.0..1.0> For the reinhard function, this specifies the local contrast "
#~ "coefficient at the display peak. Essentially, a value of 0.5 implies that "
#~ "the reference white will be about half as bright as when clipping. "
#~ "Defaults to 0.5."
#~ msgstr ""
#~ "<0.0..1.0> 对于reinhard 功能，指定显示峰值处的局部对比度系数。本质上，0.5 "
#~ "的值意味着参考白色的亮度约为剪切时的一半。默认为 0.5。"

#~ msgid ""
#~ "<0.0..1.0> Knee point to use for soft-clipping methods (perceptual, "
#~ "softclip). Defaults to 0.70."
#~ msgstr "<0.0..1.0> 用于软剪裁方法（感知、软剪裁）的拐点。默认为 0.70。"

#~ msgid ""
#~ "<0.0..1.0> Strength of the perceptual saturation mapping component. "
#~ "Defaults to 0.80."
#~ msgstr "<0.0..1.0> 感知饱和度映射分量的强度。默认为 0.80。"

#~ msgid "<0.0..1.0> The center (bias) of the sigmoid curve. Defaults to 0.75."
#~ msgstr "<0.0..1.0> S 型曲线的中心（偏差）。默认为 0.75。"

#~ msgid ""
#~ "<0.0..10.0> For linear methods (linear, linearlight), this controls the "
#~ "linear exposure/gain applied to the image. Defaults to 1.0."
#~ msgstr ""
#~ "<0.0..10.0> 对于 linear 方法（linear，线性光），它控制应用于图像的 linear "
#~ "曝光/增益。默认为 1.0。"

#~ msgid ""
#~ "<0.0..10.0> I vs C curve gamma to use for colorimetric clipping "
#~ "(relative, absolute and darken). Defaults to 1.80."
#~ msgstr ""
#~ "<0.0..10.0> I vs C 曲线 gamma 用于比色剪裁（相对、绝对和变暗）。默认为 "
#~ "1.80。"

#~ msgid "<0.0..100.0> Black cutoff strength."
#~ msgstr "<0.0..100.0> 黑色截止强度。"

#~ msgid ""
#~ "<0.0..100.0> Contrast gain. Multiplies the source luminance signal by a "
#~ "constant factor. 1.0 = neutral, 0.0 = solid black. Defaults to 1.0."
#~ msgstr ""
#~ "<0.0..100.0> 对比度增益。将源亮度信号乘以常数因子。 1.0 = 中性色，0.0 = 纯"
#~ "黑色。默认为 1.0。"

#~ msgid ""
#~ "<0.0..100.0> Gamma lift. Subjectively brightnes or darkens the scene "
#~ "while preserving overall contrast. 1.0 = neutral, 0.0 = solid black. "
#~ "Defaults to 1.0."
#~ msgstr ""
#~ "<0.0..100.0> 伽玛提升机。主观地使场景变亮或变暗，同时保持整体对比度。 1.0 "
#~ "= 中性色，0.0 = 纯黑色。默认为 1.0。"

#~ msgid ""
#~ "<0.0..100.0> Saturation gain. Multiplies the source chromaticity signal "
#~ "by a constant factor. 1.0 = neutral, 0.0 = grayscale. Defaults to 1.0."
#~ msgstr ""
#~ "<0.0..100.0> 饱和增益。将源色度信号乘以常数因子。 1.0 = 中性，0.0 = 灰度。"
#~ "默认为 1.0。"

#~ msgid ""
#~ "<0.0..100.0> Which percentile of the input image brightness histogram to "
#~ "consider as the true peak of the scene."
#~ msgstr "<0.0..100.0> 输入图像亮度直方图的哪个百分位数被视为场景的真实峰值。"

#~ msgid ""
#~ "<0.0..1000.0> Add some extra noise to the image. This significantly helps "
#~ "cover up remaining quantization artifacts. Higher numbers add more noise. "
#~ "Defaults to 4.0, which is very mild."
#~ msgstr ""
#~ "<0.0..1000.0> 向图像添加一些额外的噪点。这极大地有助于掩盖剩余的量化伪影。"
#~ "数字越大，噪音越大。默认为4.0，非常温和。"

#~ msgid "<0.0..1000.0> Smoothing coefficient for the detected values."
#~ msgstr "<0.0..1000.0> 检测值的平滑系数。"

#~ msgid ""
#~ "<0.0..1000.0> The debanding filter's cut-off threshold. Higher numbers "
#~ "increase the debanding strength dramatically, but progressively diminish "
#~ "image details. Defaults to 3.0."
#~ msgstr ""
#~ "<0.0..1000.0> 去带滤波器的截止阈值。较高的数字会显着增加去带强度，但会逐渐"
#~ "减少图像细节。默认为 3.0。"

#~ msgid ""
#~ "<0.0..1000.0> The debanding filter's initial radius. The radius increases "
#~ "linearly for each iteration. A higher radius will find more gradients, "
#~ "but a lower radius will smooth more aggressively. Defaults to 16.0."
#~ msgstr ""
#~ "<0.0..1000.0> 去带滤波器的初始半径。每次迭代半径都会线性增加。较高的半径会"
#~ "发现更多的梯度，但较低的半径会更积极地平滑。默认为 16.0。"

#~ msgid ""
#~ "<0.5..1.0> Configures the knee point maximum as a percentage of the PQ "
#~ "luminance range. Provides a hard limit on the knee point chosen by "
#~ "knee_adaptation. Defaults to 0.8."
#~ msgstr ""
#~ "<0.5..1.0> 将拐点最大值配置为 PQ 亮度范围的百分比。对knee_adaptation选择的"
#~ "拐点提供硬性限制。默认为 0.8。"

#~ msgid ""
#~ "<0.5..2.0> Knee point offset (for bt2390 only). Note that a value of 0.5 "
#~ "is the spec-defined default behavior, which differs from the libplacebo "
#~ "default of 1.0."
#~ msgstr ""
#~ "<0.5..2.0> 拐点偏移（仅适用于 bt2390）。请注意，0.5 的值是规范定义的 "
#~ "default 行为，它与 1.0 的 libplacebo default 不同。"

#~ msgid ""
#~ "<1.0..20.0> The slope (steepness) of the sigmoid curve. Defaults to 6.5."
#~ msgstr "<1.0..20.0> S 型曲线的斜率（陡度）。默认为 6.5。"

#~ msgid ""
#~ "<1.0..32.0> HDR contrast recovery lowpass kernel size. Increasing or "
#~ "decreasing this will affect the visual appearance substantially. Defaults "
#~ "to 3.5."
#~ msgstr ""
#~ "<1.0..32.0> HDR 对比恢复低通核大小。增加或减少此值将极大地影响视觉外观。默"
#~ "认为 3.5。"

#~ msgid ""
#~ "<N|inf|force|no> Loops playback N times. A value of 1 plays it one time "
#~ "(default), 2 two times, etc. inf means forever. no is the same as 1 and "
#~ "disables looping. If several files are specified on command line, the "
#~ "entire playlist is looped. The force mode is like inf, but does not skip "
#~ "playlist entries which have been marked as failing. This means the player "
#~ "might waste CPU time trying to loop a file that doesn't exist. But it "
#~ "might be useful for playing webradios under very bad network conditions."
#~ msgstr ""
#~ "<N|inf|force|no> 循环播放 N 次。 1 的值播放一次（default），2 播放两次，依"
#~ "此类推。inf 表示永远。 no 与 1 相同，禁用循环。如果在命令行上指定了多个文"
#~ "件，则循环整个播放列表。强制模式类似于 inf，但不会跳过已标记为失败的播放列"
#~ "表条目。这意味着玩家可能会浪费 CPU 时间来尝试循环不存在的文件。但它对于在"
#~ "非常糟糕的网络条件下播放网络广播可能很有用。"

#~ msgid ""
#~ "<N|inf|no> Loop a single file N times. inf means forever, no means normal "
#~ "playback.\\n\\nThe difference to loop-playlist is that this doesn't loop "
#~ "the playlist, just the file itself. If the playlist contains only a "
#~ "single file, the difference between the two option is that this option "
#~ "performs a seek on loop, instead of reloading the file. loop is an alias "
#~ "for this option."
#~ msgstr ""
