<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Condition="'$(VisualStudioVersion)' == '' or '$(VisualStudioVersion)' &lt; '15.0'">
    <VisualStudioVersion>15.0</VisualStudioVersion>
  </PropertyGroup>
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x86">
      <Configuration>Debug</Configuration>
      <Platform>x86</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x86">
      <Configuration>Release</Configuration>
      <Platform>x86</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|ARM">
      <Configuration>Debug</Configuration>
      <Platform>ARM</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|ARM">
      <Configuration>Release</Configuration>
      <Platform>ARM</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|ARM64">
      <Configuration>Debug</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|ARM64">
      <Configuration>Release</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|AnyCPU">
      <Configuration>Debug</Configuration>
      <Platform>AnyCPU</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|AnyCPU">
      <Configuration>Release</Configuration>
      <Platform>AnyCPU</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <WapProjPath Condition="'$(WapProjPath)'=='' and Exists('$(MSBuildExtensionsPath)\Microsoft\DesktopBridge\Microsoft.DesktopBridge.props')">$(MSBuildExtensionsPath)\Microsoft\DesktopBridge\</WapProjPath>
    <WapProjPath Condition="'$(WapProjPath)'=='' and Exists('$(MSBuildProgramFiles32)\Microsoft Visual Studio\18\Community\MSBuild\Microsoft\DesktopBridge\Microsoft.DesktopBridge.props')">$(MSBuildProgramFiles32)\Microsoft Visual Studio\18\Community\MSBuild\Microsoft\DesktopBridge\</WapProjPath>
    <WapProjPath Condition="'$(WapProjPath)'=='' and Exists('$(MSBuildProgramFiles32)\Microsoft Visual Studio\18\Professional\MSBuild\Microsoft\DesktopBridge\Microsoft.DesktopBridge.props')">$(MSBuildProgramFiles32)\Microsoft Visual Studio\18\Professional\MSBuild\Microsoft\DesktopBridge\</WapProjPath>
    <WapProjPath Condition="'$(WapProjPath)'=='' and Exists('$(MSBuildProgramFiles32)\Microsoft Visual Studio\18\Enterprise\MSBuild\Microsoft\DesktopBridge\Microsoft.DesktopBridge.props')">$(MSBuildProgramFiles32)\Microsoft Visual Studio\18\Enterprise\MSBuild\Microsoft\DesktopBridge\</WapProjPath>
    <WapProjPath Condition="'$(WapProjPath)'=='' and Exists('$(MSBuildProgramFiles32)\Microsoft Visual Studio\18\BuildTools\MSBuild\Microsoft\DesktopBridge\Microsoft.DesktopBridge.props')">$(MSBuildProgramFiles32)\Microsoft Visual Studio\18\BuildTools\MSBuild\Microsoft\DesktopBridge\</WapProjPath>
    <WapProjPath Condition="'$(WapProjPath)'=='' and Exists('$(MSBuildProgramFiles32)\Microsoft Visual Studio\17\Community\MSBuild\Microsoft\DesktopBridge\Microsoft.DesktopBridge.props')">$(MSBuildProgramFiles32)\Microsoft Visual Studio\17\Community\MSBuild\Microsoft\DesktopBridge\</WapProjPath>
    <WapProjPath Condition="'$(WapProjPath)'=='' and Exists('$(MSBuildProgramFiles32)\Microsoft Visual Studio\17\Professional\MSBuild\Microsoft\DesktopBridge\Microsoft.DesktopBridge.props')">$(MSBuildProgramFiles32)\Microsoft Visual Studio\17\Professional\MSBuild\Microsoft\DesktopBridge\</WapProjPath>
    <WapProjPath Condition="'$(WapProjPath)'=='' and Exists('$(MSBuildProgramFiles32)\Microsoft Visual Studio\17\Enterprise\MSBuild\Microsoft\DesktopBridge\Microsoft.DesktopBridge.props')">$(MSBuildProgramFiles32)\Microsoft Visual Studio\17\Enterprise\MSBuild\Microsoft\DesktopBridge\</WapProjPath>
    <WapProjPath Condition="'$(WapProjPath)'=='' and Exists('$(MSBuildProgramFiles32)\Microsoft Visual Studio\17\BuildTools\MSBuild\Microsoft\DesktopBridge\Microsoft.DesktopBridge.props')">$(MSBuildProgramFiles32)\Microsoft Visual Studio\17\BuildTools\MSBuild\Microsoft\DesktopBridge\</WapProjPath>
  </PropertyGroup>
  <PropertyGroup>
    <HasDesktopBridgeTargets Condition="Exists('$(WapProjPath)\Microsoft.DesktopBridge.targets')">true</HasDesktopBridgeTargets>
    <HasDesktopBridgeTargets Condition="'$(HasDesktopBridgeTargets)'==''">false</HasDesktopBridgeTargets>
  </PropertyGroup>
  <PropertyGroup>
    <PackageIdentityName Condition="'$(PackageIdentityName)'==''">24183GestodeSistemas.MPV.NETMediaPlayer</PackageIdentityName>
    <PackagePublisher Condition="'$(PackagePublisher)'==''">CN=6581967D-2DE4-48DE-A846-C6F69ECA7701</PackagePublisher>
    <PackagePublisherDisplayName Condition="'$(PackagePublisherDisplayName)'==''">Gestão de Sistemas</PackagePublisherDisplayName>
    <PackageDisplayName Condition="'$(PackageDisplayName)'==''">MPV.NET Media Player</PackageDisplayName>
    <ProjectPriIndexName Condition="'$(ProjectPriIndexName)'==''">$(PackageIdentityName)</ProjectPriIndexName>
    <PackageSigningMode Condition="'$(PackageSigningMode)'==''">Temporary</PackageSigningMode>
    <PackageCertificateKeyFile Condition="'$(PackageCertificateKeyFile)'=='' and '$(PackageSigningMode)'=='Temporary'">MpvNet.Pacote_TemporaryKey.pfx</PackageCertificateKeyFile>
    <GenerateTemporaryStoreCertificate Condition="'$(GenerateTemporaryStoreCertificate)'=='' and '$(PackageSigningMode)'=='Temporary'">True</GenerateTemporaryStoreCertificate>
    <GenerateTemporaryStoreCertificate Condition="'$(GenerateTemporaryStoreCertificate)'=='' and '$(PackageSigningMode)'!='Temporary'">False</GenerateTemporaryStoreCertificate>
  </PropertyGroup>
  <Import Project="..\BuildVersion.props" Condition="Exists('..\BuildVersion.props')" />
  <Import Project="Packaging.Distribution.props" Condition="Exists('Packaging.Distribution.props')" />
  <Import Project="$(WapProjPath)\Microsoft.DesktopBridge.props" Condition="Exists('$(WapProjPath)\Microsoft.DesktopBridge.props')" />
  <Target Name="EnsureDesktopBridgeProps" BeforeTargets="PrepareForBuild" Condition="'$(HasDesktopBridgeTargets)'!='true'">
    <Warning Text="Microsoft.DesktopBridge.props nao foi encontrado. O empacotamento MSIX sera ignorado nesta maquina. Instale os componentes Desktop Bridge/MSIX do Visual Studio ou defina WapProjPath apontando para a pasta Microsoft\\DesktopBridge para gerar o pacote." />
  </Target>
  <PropertyGroup>
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
    <ProjectGuid>{C9D3A4D2-3F1F-4B8F-A5E7-8A3F92ED43C1}</ProjectGuid>
    <TargetPlatformVersion>10.0.26100.0</TargetPlatformVersion>
    <TargetPlatformMinVersion>10.0.14393.0</TargetPlatformMinVersion>
    <DefaultLanguage>pt-BR</DefaultLanguage>
    <AppxPackageSigningEnabled>True</AppxPackageSigningEnabled>
    <NoWarn>$(NoWarn);NU1702</NoWarn>
    <EntryPointProjectUniqueName>..\MpvNet.Windows\MpvNet.Windows.csproj</EntryPointProjectUniqueName>
    <GenerateAppInstallerFile>False</GenerateAppInstallerFile>
    <AppxPackageSigningTimestampDigestAlgorithm>SHA256</AppxPackageSigningTimestampDigestAlgorithm>
    <AppxAutoIncrementPackageRevision>True</AppxAutoIncrementPackageRevision>
    <GenerateTestArtifacts>True</GenerateTestArtifacts>
    <AppxBundlePlatforms>x64</AppxBundlePlatforms>
    <HoursBetweenUpdateChecks>0</HoursBetweenUpdateChecks>
    <PackageCertificateThumbprint>BCDF895168CC0300EE778E914D93BE0B353B8707</PackageCertificateThumbprint>
  </PropertyGroup>
  <Target Name="ValidateDistributionSigning" BeforeTargets="GenerateAppxPackageOnBuild">
    <Message Importance="High" Condition="'$(PackageSigningMode)'=='Temporary'" Text="Empacotamento usando certificado temporario de desenvolvimento. Para distribuicao publica, crie MpvNet.Pacote\\Packaging.Distribution.props com certificado valido." />
    <Error Condition="'$(PackageSigningMode)'=='Distribution' and '$(PackageCertificateKeyFile)'==''" Text="PackageSigningMode=Distribution exige PackageCertificateKeyFile configurado em Packaging.Distribution.props." />
    <Error Condition="'$(PackageSigningMode)'=='Distribution' and '$(PackagePublisher)'==''" Text="PackageSigningMode=Distribution exige PackagePublisher configurado em Packaging.Distribution.props." />
  </Target>
  <Target Name="ValidatePackageManifestVersion" BeforeTargets="GenerateAppxPackageOnBuild">
    <XmlPeek XmlInputPath="Package.appxmanifest" Namespaces="&lt;Namespace Prefix='appx' Uri='http://schemas.microsoft.com/appx/manifest/foundation/windows10' /&gt;" Query="/appx:Package/appx:Identity/@Version">
      <Output TaskParameter="Result" PropertyName="PackageManifestVersion" />
    </XmlPeek>
    <Error Condition="'$(MpvNetVersion)'==''" Text="MpvNetVersion nao foi carregado. Verifique BuildVersion.props antes de gerar o pacote." />
    <Error Condition="'$(PackageManifestVersion)'!='$(MpvNetVersion)'" Text="Versao desalinhada para publicacao: BuildVersion.props define $(MpvNetVersion), mas Package.appxmanifest esta em $(PackageManifestVersion). Atualize os dois antes de gerar o pacote para a Microsoft Store." />
  </Target>
  <Target Name="ValidateStorePackage" DependsOnTargets="ValidateDistributionSigning;ValidatePackageManifestVersion">
    <Message Importance="High" Text="Validacao do pacote Store concluida: assinatura e versao do manifest estao consistentes." />
  </Target>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|ARM64'">
    <AppxBundle>Always</AppxBundle>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x86'">
    <AppxBundle>Always</AppxBundle>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|ARM'">
    <AppxBundle>Always</AppxBundle>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <AppxBundle>Always</AppxBundle>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|ARM'">
    <AppxBundle>Always</AppxBundle>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x86'">
    <AppxBundle>Always</AppxBundle>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <AppxBundle>Always</AppxBundle>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|ARM64'">
    <AppxBundle>Always</AppxBundle>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <AppxBundle>Always</AppxBundle>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <AppxBundle>Always</AppxBundle>
  </PropertyGroup>
  <ItemGroup>
    <AppxManifest Include="Package.appxmanifest">
      <SubType>Designer</SubType>
    </AppxManifest>
  </ItemGroup>
