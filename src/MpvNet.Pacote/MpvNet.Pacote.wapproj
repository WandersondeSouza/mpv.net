  </ItemGroup>
  <Target Name="Build" Condition="'$(HasDesktopBridgeTargets)'!='true'">
    <Message Importance="High" Text="Ignorando a compilacao de MpvNet.Pacote porque os targets do Desktop Bridge/MSIX nao estao instalados nesta maquina." />
  </Target>
  <Target Name="Rebuild" DependsOnTargets="Build" Condition="'$(HasDesktopBridgeTargets)'!='true'" />
  <Target Name="Clean" Condition="'$(HasDesktopBridgeTargets)'!='true'">
    <Message Importance="Low" Text="Nada para limpar em MpvNet.Pacote sem os targets do Desktop Bridge/MSIX." />
  </Target>
  <Import Project="$(WapProjPath)\Microsoft.DesktopBridge.targets" Condition="Exists('$(WapProjPath)\Microsoft.DesktopBridge.targets')" />
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MpvNet.Windows\MpvNet.Windows.csproj">
      <AdditionalProperties>SelfContained=false;PublishSelfContained=false;PublishSingleFile=false;PublishReadyToRun=false</AdditionalProperties>
    </ProjectReference>
