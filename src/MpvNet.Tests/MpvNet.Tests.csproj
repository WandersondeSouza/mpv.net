<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
		<RootNamespace>MpvNet.Tests</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\MpvNet\MpvNet.csproj" />
		<ProjectReference Include="..\MpvNet.Windows\MpvNet.Windows.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="xunit.v3" />
		<PackageReference Include="xunit.runner.visualstudio">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="TngTech.ArchUnitNET.xUnitV3" />
	</ItemGroup>

  <Target Name="CopyTestRuntimeAssets" AfterTargets="Build">
    <MSBuild Projects="$(MSBuildProjectDirectory)\..\MpvNet.Windows\MpvNet.Windows.csproj"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration);Platform=$(Platform);RuntimeIdentifier=$(RuntimeIdentifier)">
      <Output TaskParameter="TargetOutputs" ItemName="TestPlayerOutput" />
    </MSBuild>
    <PropertyGroup>
      <TestPlayerOutputDirectory>@(TestPlayerOutput->'%(RootDir)%(Directory)')</TestPlayerOutputDirectory>
    </PropertyGroup>
    <ItemGroup>
      <TestNativeAsset Include="$(TestPlayerOutputDirectory)libmpv*.dll;$(TestPlayerOutputDirectory)libmpv-builds.json;$(TestPlayerOutputDirectory)MediaInfo.dll" />
      <TestLocale Include="$(TestPlayerOutputDirectory)Locale\**\*.mo" />
      <TestPlayerScript Include="$(TestPlayerOutputDirectory)Scripts\osc.lua" />
    </ItemGroup>
    <Copy SourceFiles="@(TestNativeAsset)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(TestLocale)" DestinationFiles="@(TestLocale->'$(TargetDir)Locale\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(TestPlayerScript)" DestinationFolder="$(TargetDir)Scripts" SkipUnchangedFiles="true" />
    <Error Condition="!Exists('$(TargetDir)libmpv-2.dll')"
           Text="The test runtime requires libmpv-2.dll. Prepare the Windows build assets before running native tests." />
  </Target>

</Project>
