<Window
    x:Class="MpvNet.Windows.WPF.Views.AboutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ngettext="clr-namespace:NGettext.Wpf;assembly=NGettext.Wpf"
    mc:Ignorable="d"
    
    Title="{Binding WindowTitle}"
    FontSize="16"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize"
    SizeToContent="WidthAndHeight"
    Foreground="{Binding Theme.Foreground}"
    Background="{Binding Theme.Background}"
    >

    <Window.InputBindings>
        <KeyBinding Key="Esc" Command="{Binding CloseCommand}"/>
    </Window.InputBindings>
    
    <Grid>
        <StackPanel HorizontalAlignment="Center">
            <TextBox
                IsReadOnly="True"
                Text="{Binding About, Mode=OneWay}"
                TextWrapping="Wrap"
                TextAlignment="Center"
                MaxWidth="720"
                Margin="20,10,20,12"
                BorderThickness="0"
                Foreground="{Binding Theme.Foreground}"
                Background="{Binding Theme.Background}">
            </TextBox>

            <TextBlock
                TextAlignment="Center"
                Margin="20,0,20,20"
                Foreground="{Binding Theme.Foreground}">
                <Run Text="{Binding CodecGuideLabel, Mode=OneWay}" />
                <Hyperlink Click="CodecGuideLink_Click">codecguide.com</Hyperlink>
            </TextBlock>

            <Border
                Margin="20,0,20,20"
                Padding="16"
                CornerRadius="10"
                BorderThickness="1"
                BorderBrush="{Binding Theme.Foreground}"
                Background="{Binding Theme.Background}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock
                            Text="{Binding DonationTitle}"
                            TextWrapping="Wrap"
                            Foreground="{Binding Theme.Foreground}" />

                        <TextBlock
                            Margin="0,10,0,0"
                            Text="{Binding DonationCopyPaste}"
                            FontWeight="Bold"
                            Foreground="{Binding Theme.Foreground}" />

                        <Button
                            Margin="0,6,0,0"
                            Padding="8"
                            BorderThickness="1"
                            HorizontalContentAlignment="Left"
                            VerticalContentAlignment="Center"
                            Foreground="{Binding Theme.Foreground}"
                            Background="{Binding Theme.Background}"
                            Click="DonationPixKey_Click">
                            <TextBlock
                                Text="{Binding DonationPixKey}"
                                TextWrapping="Wrap"
                                Foreground="{Binding Theme.Foreground}" />
                        </Button>
                    </StackPanel>

                    <Image
                        Grid.Column="1"
                        Width="240"
                        Height="240"
                        Stretch="Uniform"
                        Source="/MpvNet.Windows;component/pix-donation-qr.png"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</Window>
